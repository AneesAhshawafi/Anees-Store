# ===============================================
# إعدادات بوت متجر أنيس — Anees Store Bot Config
# ===============================================

# 1. توكن البوت من @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. معرف الأدمن في تيليجرام (يمكن وضع أكثر من آيدي مفصولين بفواصل: 123456,789101)
ADMIN_ID=123456789

# 3. رابط الاتصال بقاعدة بيانات MongoDB (محلي أو Atlas سحابي)
MONGO_URI=mongodb://localhost:27017/
DB_NAME=anees_store

# 4. كود الاتصال الأولي (يتم حفظه تلقائياً في MongoDB ولا يوضع API_KEY في الكود أبداً)
INITIAL_CONNECTION_CODE=conn_eyJrIjoic2tfOTEwMTA1Y2I4ZDVkNWFjOTVjNzA4Njg4Y2I2NjhmNmEzMjc2ODVhMDFlYmNiMjA3IiwidSI6Imh0dHBzOi8vaW5zMjExMjEzMS1md2YxLm9ucmVuZGVyLmNvbS84ZjcxYWVkZDM0OTRlMDQyYmIwNjQwOGY1MGI3ZjkzOCJ9

# 5. نظام رصيد المستخدمين الداخلي في المتجر:
# True: يجب أن يملك العميل رصيداً كافياً في البوت قبل الشراء (يشحن له الأدمن عبر /add_balance).
# False: يتم الشراء مباشرة عبر API المتجر بالاعتماد على رصيد حسابك في الـ API.
REQUIRE_USER_BALANCE=False

# 6. المزامنة التلقائية للمخزون بالثواني (0 لتعطيل الفحص التلقائي واستخدام /sync فقط)
POLL_INTERVAL_SECONDS=30

# 7. عدد المنتجات المعروضة في كل صفحة بالكتالوج
PRODUCTS_PER_PAGE=8
